/// Persistent annotation overlay stored separately from the encrypted document.
/// Supports highlight, text, draw, comment, and signature annotation types.
model Annotation {
  id         String   @id @default(cuid())
  fileId     String
  pageNumber Int
  type       String   // "highlight" | "text" | "draw" | "comment" | "signature"
  data       String   // JSON blob (DocumentAnnotation shape)
  authorId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  UserFile   UserFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([pageNumber])
}

/// Records a user's active editing session for presence tracking.
model DocumentSession {
  id         String   @id @default(cuid())
  fileId     String
  userId     String?
  token      String   // share token used for authentication
  role       String   @default("VENDOR")
  displayName String  @default("User")
  color      String   @default("#6366f1")
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([fileId])
  @@index([token])
}

/// Append-only log of all collaboration operations for audit and replay.
model CollabOperation {
  id        String   @id @default(cuid())
  fileId    String
  sessionId String
  opType    String   // "insert" | "delete" | "update" | "annotate" | "cursor" | "comment"
  payload   String   // JSON — DocumentOperation payload
  version   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([fileId])
  @@index([createdAt])
}
