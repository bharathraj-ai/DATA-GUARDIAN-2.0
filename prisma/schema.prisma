generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuditLog {
  id         String      @id @default(cuid())
  action     String
  timestamp  DateTime    @default(now())
  linkId     String?
  metadata   String?
  reason     String?
  SecureLink SecureLink? @relation(fields: [linkId], references: [id])

  @@index([action])
  @@index([linkId])
  @@index([timestamp])
}

model SecureLink {
  id                 String     @id @default(cuid())
  token              String     @unique
  otpHash            String
  expiresAt          DateTime
  isUsed             Boolean    @default(false)
  createdAt          DateTime   @default(now())
  userId             String     @unique
  isRevoked          Boolean    @default(false)
  ownerToken         String     @unique
  deviceHash         String?
  failedAttempts     Int        @default(0)
  lockedAt           DateTime?
  notificationEmail  String?
  purpose            String?
  purposeDetail      String?
  otpFirstAttemptAt  DateTime?
  otpVerifiedAt      DateTime?
  allowedVendorEmail String?
  ownerId            String?
  otpPlain           String?
  AuditLog           AuditLog[]
  User               User?      @relation(fields: [ownerId], references: [id])
  UserData           UserData   @relation(fields: [userId], references: [id], onDelete: Cascade)
  UserFile           UserFile[]

  @@index([allowedVendorEmail])
  @@index([expiresAt])
  @@index([ownerId])
  @@index([ownerToken])
  @@index([token])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          String       @default("VENDOR")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  roleSelected  Boolean      @default(false)
  Account       Account[]
  SecureLink    SecureLink[]
  Session       Session[]
  SendRecord    SendRecord[]
}

model UserData {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  dataHash      String
  encryptedData String
  SecureLink    SecureLink?
}

model UserFile {
  id               String        @id @default(cuid())
  fileName         String
  fileType         String
  fileSize         Int
  encryptedContent Bytes
  iv               String
  authTag          String
  secureLinkId     String
  createdAt        DateTime      @default(now())
  SecureLink       SecureLink    @relation(fields: [secureLinkId], references: [id], onDelete: Cascade)
  FileVersion      FileVersion[]
  Annotation       Annotation[]

  @@index([secureLinkId])
}

model FileVersion {
  id                String   @id @default(cuid())
  fileId            String
  versionNumber     Int
  encryptedContent  Bytes
  iv                String
  authTag           String
  fileSize          Int
  changeType        String   // "annotation" | "page_replace" | "restore"
  changeDescription String?
  createdAt         DateTime @default(now())
  UserFile          UserFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Preserved record of data sharing — survives data deletion.
/// Lets the owner see WHO they sent data to and WHAT topic it was about,
/// even after the actual data has been purged from the database.
model SendRecord {
  id              String   @id @default(cuid())
  ownerId         String
  topic           String                        // Mandatory: what data was shared
  vendorEmail     String?                       // Who it was sent to
  fileCount       Int      @default(0)          // How many files were attached
  status          String   @default("expired")  // expired | revoked | cleaned
  createdAt       DateTime @default(now())      // When the link was created
  expiredAt       DateTime?                     // When it expired/was revoked
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([createdAt])
}

/// Persistent annotation overlay stored separately from the encrypted document.
model Annotation {
  id         String   @id @default(cuid())
  fileId     String
  pageNumber Int
  type       String   // "highlight" | "text" | "draw" | "comment" | "signature"
  data       String   // JSON blob (DocumentAnnotation shape)
  authorId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  UserFile   UserFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([pageNumber])
}

/// Active editing session for presence tracking.
model DocumentSession {
  id          String   @id @default(cuid())
  fileId      String
  userId      String?
  token       String
  role        String   @default("VENDOR")
  displayName String   @default("User")
  color       String   @default("#6366f1")
  joinedAt    DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([fileId])
  @@index([token])
}

/// Append-only audit log of collaboration operations.
model CollabOperation {
  id        String   @id @default(cuid())
  fileId    String
  sessionId String
  opType    String
  payload   String   // JSON
  version   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([fileId])
  @@index([createdAt])
}
