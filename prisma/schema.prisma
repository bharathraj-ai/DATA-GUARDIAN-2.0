generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuditLog {
  id         String      @id @default(cuid())
  action     String
  timestamp  DateTime    @default(now())
  linkId     String?
  metadata   String?
  reason     String?
  SecureLink SecureLink? @relation(fields: [linkId], references: [id])

  @@index([action])
  @@index([linkId])
  @@index([timestamp])
}

model SecureLink {
  id                 String     @id @default(cuid())
  token              String     @unique
  otpHash            String
  expiresAt          DateTime
  isUsed             Boolean    @default(false)
  createdAt          DateTime   @default(now())
  userId             String     @unique
  isRevoked          Boolean    @default(false)
  ownerToken         String     @unique
  deviceHash         String?
  failedAttempts     Int        @default(0)
  lockedAt           DateTime?
  notificationEmail  String?
  purpose            String?
  purposeDetail      String?
  otpFirstAttemptAt  DateTime?
  otpVerifiedAt      DateTime?
  allowedVendorEmail String?
  allowEditing       Boolean    @default(false)
  ownerId            String?
  otpPlain           String?
  AuditLog           AuditLog[]
  User               User?      @relation(fields: [ownerId], references: [id])
  UserData           UserData   @relation(fields: [userId], references: [id], onDelete: Cascade)
  UserFile           UserFile[]
  VendorAccess       VendorAccess[]

  @@index([allowedVendorEmail])
  @@index([expiresAt])
  @@index([ownerId])
  @@index([ownerToken])
  @@index([token])
}

model VendorAccess {
  id             String     @id @default(cuid())
  secureLinkId   String
  email          String
  level          Int        @default(2) // 1 = Team leader
  otpHash        String?
  otpPlain       String?
  loginCount     Int        @default(0)
  maxLogins      Int        @default(3)
  failedAttempts Int        @default(0)
  isRevoked      Boolean    @default(false)
  createdAt      DateTime   @default(now())

  SecureLink     SecureLink @relation(fields: [secureLinkId], references: [id], onDelete: Cascade)

  @@unique([secureLinkId, email])
  @@index([secureLinkId])
  @@index([email])
}

model ChatMessage {
  id         String   @id @default(cuid())
  fileId     String
  sender     String
  level      Int      @default(2)
  message    String
  isPrivate  Boolean  @default(false)
  targetUser String?
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([fileId])
  @@index([createdAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          String       @default("VENDOR")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  roleSelected  Boolean      @default(false)
  Account       Account[]
  SecureLink    SecureLink[]
  Session       Session[]
  SendRecord    SendRecord[]
  Document      Document[]
}

model UserData {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  dataHash      String
  encryptedData String
  SecureLink    SecureLink?
}

model UserFile {
  id               String        @id @default(cuid())
  fileName         String
  fileType         String
  fileSize         Int
  encryptedContent Bytes
  iv               String
  authTag          String
  encryptedDek     String?
  secureLinkId     String
  createdAt        DateTime      @default(now())
  SecureLink       SecureLink    @relation(fields: [secureLinkId], references: [id], onDelete: Cascade)
  FileVersion      FileVersion[]
  Annotation       Annotation[]

  @@index([secureLinkId])
}

model FileVersion {
  id                String   @id @default(cuid())
  fileId            String
  versionNumber     Int
  encryptedContent  Bytes
  iv                String
  authTag           String
  encryptedDek      String?
  fileSize          Int
  changeType        String   // "annotation" | "page_replace" | "restore"
  changeDescription String?
  createdAt         DateTime @default(now())
  UserFile          UserFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Preserved record of data sharing — survives data deletion.
/// Lets the owner see WHO they sent data to and WHAT topic it was about,
/// even after the actual data has been purged from the database.
model SendRecord {
  id              String   @id @default(cuid())
  ownerId         String
  topic           String                        // Mandatory: what data was shared
  vendorEmail     String?                       // Who it was sent to
  fileCount       Int      @default(0)          // How many files were attached
  status          String   @default("expired")  // expired | revoked | cleaned
  createdAt       DateTime @default(now())      // When the link was created
  expiredAt       DateTime?                     // When it expired/was revoked
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([createdAt])
}

/// Persistent annotation overlay stored separately from the encrypted document.
model Annotation {
  id         String   @id @default(cuid())
  fileId     String
  pageNumber Int
  type       String   // "highlight" | "text" | "draw" | "comment" | "signature"
  data       String   // JSON blob (DocumentAnnotation shape)
  authorId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  UserFile   UserFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([pageNumber])
}

/// Active editing session for presence tracking.
model DocumentSession {
  id          String   @id @default(cuid())
  fileId      String
  userId      String?
  token       String
  role        String   @default("VENDOR")
  displayName String   @default("User")
  color       String   @default("#6366f1")
  level       Int      @default(2) // Hierarchy Level (1=Highest)
  joinedAt    DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([fileId])
  @@index([token])
}

/// Append-only audit log of collaboration operations.
model CollabOperation {
  id        String   @id @default(cuid())
  fileId    String
  sessionId String
  opType    String
  payload   String   // JSON
  version   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([fileId])
  @@index([createdAt])
}

// ============================================
// ONLYOFFICE DOCUMENT MANAGEMENT
// ============================================

/// Secure document metadata for ONLYOFFICE-managed files.
/// Actual files are stored on disk at storagePath — never publicly accessible.
model Document {
  id             String             @id @default(cuid())
  fileName       String
  fileType       String             // Extension: docx, xlsx, pptx, etc.
  mimeType       String             @default("application/octet-stream")
  storagePath    String             // Relative path inside secure-storage
  fileSize       Int                @default(0)
  ownerId        String
  classification String             @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
  currentVersion Int                @default(1)
  isDeleted      Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions       DocumentVersion[]
  auditLogs      DocumentAuditLog[]

  @@index([ownerId])
  @@index([classification])
  @@index([createdAt])
  @@index([isDeleted])
}

/// Version history entry — stores path to previous version on disk.
model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  version     Int
  storagePath String   // e.g. /secure-storage/versions/{docId}/{version}.docx
  fileSize    Int      @default(0)
  changeType  String   @default("edit") // "edit" | "autosave" | "force_save" | "restore"
  changedBy   String?  // userId who triggered the save
  createdAt   DateTime @default(now())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
  @@index([createdAt])
}

/// Append-only audit log for every document event.
model DocumentAuditLog {
  id         String   @id @default(cuid())
  documentId String
  userId     String?
  action     String   // "upload" | "view" | "edit" | "download" | "delete"
  ipAddress  String?
  userAgent  String?
  metadata   String?  // JSON — extra context
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
