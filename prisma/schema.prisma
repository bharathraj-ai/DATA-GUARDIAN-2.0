generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuditLog {
  id         String      @id @default(cuid())
  action     String
  timestamp  DateTime    @default(now())
  linkId     String?
  metadata   String?
  reason     String?
  SecureLink SecureLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  @@index([action])
  @@index([linkId])
  @@index([timestamp])
}

model SecureLink {
  id                 String     @id @default(cuid())
  token              String     @unique
  otpHash            String
  expiresAt          DateTime
  isUsed             Boolean    @default(false)
  createdAt          DateTime   @default(now())
  userId             String     @unique
  isRevoked          Boolean    @default(false)
  ownerToken         String     @unique
  deviceHash         String?
  failedAttempts     Int        @default(0)
  lockedAt           DateTime?
  notificationEmail  String?
  purpose            String?
  purposeDetail      String?
  otpFirstAttemptAt  DateTime?
  otpVerifiedAt      DateTime?
  allowedVendorEmail String?
  allowEditing       Boolean    @default(false)
  allowDownload      Boolean    @default(true)
  allowComment       Boolean    @default(true)
  maxViews           Int?       // Null means unlimited
  maxDownloads       Int?       // Null means unlimited
  ownerId            String?
  AuditLog           AuditLog[]
  User               User?      @relation(fields: [ownerId], references: [id])
  UserData           UserData      @relation(fields: [userId], references: [id], onDelete: Cascade)
  UserFile           UserFile[]
  LinkAccess         LinkAccess[]
  ChatMessage        ChatMessage[]
  VendorAccess       VendorAccess[]
  @@index([expiresAt])
  @@index([ownerId])
  @@index([ownerToken])
  @@index([token])
}
enum VendorStatus {
  active
  break
  completed
  expired
}

model VendorAccess {
  id             String     @id @default(cuid())
  secureLinkId   String
  email          String
  level          Int        @default(2) // 1 = Team leader
  otpHash        String?
  loginCount     Int        @default(0)
  maxLogins      Int        @default(3)
  failedAttempts Int        @default(0)
  isRevoked      Boolean    @default(false)
  createdAt      DateTime   @default(now())

  // Session & Resume Fields
  status             VendorStatus @default(active)
  lastSavedWork      Json?
  resumePoint        Json?
  lastCommitAt       DateTime?
  breakStartedAt     DateTime?
  currentPage        Int        @default(1)
  activeWorkDuration Int        @default(0)
  totalBreakDuration Int        @default(0)
  draftVersion       Int        @default(1)
  activeSessionId    String?
  /// Device fingerprint bound to the CURRENT active access session only.
  /// Cleared when the session ends (break / revoke / complete / expiry).
  /// Must NOT permanently bind the share link to the creator or first opener.
  activeDeviceHash   String?
  lastLoginAt        DateTime?
  lastSeenAt         DateTime?

  // Break-Based OTP Rotation
  taskDurationHours   Int        @default(8)
  allowedBreaks       Int        @default(3)     // Math.floor(taskDurationHours / 2) - 1
  breaksUsed          Int        @default(0)
  currentOtpHash      String?                    // Only this hash is accepted for authentication
  currentOtpCreatedAt DateTime?
  currentOtpExpiresAt DateTime?

  OtpHistory     OtpHistory[]
  SecureLink     SecureLink @relation(fields: [secureLinkId], references: [id], onDelete: Cascade)

  @@unique([secureLinkId, email])
  @@index([secureLinkId])
  @@index([email])
}

/// Append-only OTP history for forensic audit.
/// Records are NEVER deleted — only marked INVALIDATED when a break occurs.
/// Only the newest ACTIVE OTP is accepted for authentication.
model OtpHistory {
  id              String       @id @default(cuid())
  vendorAccessId  String
  otpHash         String
  createdAt       DateTime     @default(now())
  invalidatedAt   DateTime?
  reason          String       @default("INITIAL")      // INITIAL | BREAK_STARTED | EXPIRED | REVOKED
  status          String       @default("ACTIVE")       // ACTIVE | INVALIDATED

  VendorAccess    VendorAccess @relation(fields: [vendorAccessId], references: [id], onDelete: Cascade)

  @@index([vendorAccessId])
  @@index([status])
}


model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          String       @default("VENDOR")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  roleSelected  Boolean      @default(false)
  Account       Account[]
  SecureLink    SecureLink[]
  Session       Session[]
  SendRecord    SendRecord[]
  Document      Document[]
  documentGrants DocumentGrant[] @relation("DocumentGrantee")
}

model UserData {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  dataHash      String
  encryptedData String
  SecureLink    SecureLink?
}

model UserFile {
  id               String        @id @default(cuid())
  fileName         String
  fileType         String
  fileSize         Int
  version          Int           @default(1)
  eTag             String        @default(cuid()) // Conflict detection
  lockedBy         String?       // ID of user currently holding the lock
  encryptedContent Bytes?
  iv               String?
  authTag          String?
  encryptedDek     String?
  mongoFileId      String?       @unique
  mongoFile        MongoFile?    @relation(fields: [mongoFileId], references: [id])
  status               String        @default("draft") // draft | editing | submitted | approved | rejected | revoked
  submittedAt          DateTime?
  submittedBy          String?
  editingLocked        Boolean       @default(false)
  vendorDownloadBlocked Boolean      @default(true)
  secureLinkId         String
  SecureLink           SecureLink    @relation(fields: [secureLinkId], references: [id], onDelete: Cascade)
  FileVersion          FileVersion[]
  Annotation           Annotation[]

  @@index([secureLinkId])
  @@index([status])
}

model FileVersion {
  id                String   @id @default(cuid())
  fileId            String
  versionNumber     Int
  encryptedContent  Bytes
  iv                String
  authTag           String
  encryptedDek      String?
  fileSize          Int
  changeType        String   // "annotation" | "page_replace" | "restore"
  changeDescription String?
  createdAt         DateTime @default(now())
  UserFile          UserFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, versionNumber])
  @@index([fileId])
  @@index([createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Preserved record of data sharing — survives data deletion.
/// Lets the owner see WHO they sent data to and WHAT topic it was about,
/// even after the actual data has been purged from the database.
model SendRecord {
  id              String   @id @default(cuid())
  ownerId         String
  topic           String                        // Mandatory: what data was shared
  vendorEmail     String?                       // Who it was sent to
  fileCount       Int      @default(0)          // How many files were attached
  status          String   @default("expired")  // expired | revoked | cleaned
  createdAt       DateTime @default(now())      // When the link was created
  expiredAt       DateTime?                     // When it expired/was revoked
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([createdAt])
}

/// Persistent annotation overlay stored separately from the encrypted document.
model Annotation {
  id         String   @id @default(cuid())
  fileId     String
  pageNumber Int
  type       String   // "highlight" | "text" | "draw" | "comment" | "signature"
  data       String   // JSON blob (DocumentAnnotation shape)
  authorId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  UserFile   UserFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([pageNumber])
}

/// Active editing session for presence tracking.
model DocumentSession {
  id          String   @id @default(cuid())
  fileId      String
  userId      String?
  token       String
  role        String   @default("VENDOR")
  level       Int      @default(2) // 1 = Team Leader, 2+ = Members
  displayName String   @default("User")
  color       String   @default("#6366f1")
  joinedAt    DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([fileId])
  @@index([token])
}

/// Append-only audit log of collaboration operations.
model CollabOperation {
  id        String   @id @default(cuid())
  fileId    String
  sessionId String
  opType    String
  payload   String   // JSON
  version   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([fileId])
  @@index([createdAt])
}

/// Link access mapping for multiple vendors with hierarchy levels.
model LinkAccess {
  id           String     @id @default(cuid())
  secureLinkId String
  vendorEmail  String
  level            Int        @default(2) // 1 = Team Leader, 2+ = Member
  otpHash          String?    // Per-vendor unique OTP hash
  isUsed           Boolean    @default(false)
  otpVerifiedAt    DateTime?
  deviceHash       String?
  failedAttempts   Int        @default(0)
  lockedAt         DateTime?
  otpFirstAttemptAt DateTime?
  SecureLink       SecureLink @relation(fields: [secureLinkId], references: [id], onDelete: Cascade)

  @@unique([secureLinkId, vendorEmail])
  @@index([vendorEmail])
}

/// Real-time collaboration chat messages.
model ChatMessage {
  id            String     @id @default(cuid())
  secureLinkId  String
  senderEmail   String
  receiverEmail String?    // null = Group Chat, string = Direct Message
  content       String
  timestamp     DateTime   @default(now())
  SecureLink    SecureLink @relation(fields: [secureLinkId], references: [id], onDelete: Cascade)

  @@index([secureLinkId])
  @@index([timestamp])
}

// ============================================
// ONLYOFFICE DOCUMENT MANAGEMENT
// ============================================

/// Secure document metadata for ONLYOFFICE-managed files.
/// Actual files are stored on disk at storagePath — never publicly accessible.
model Document {
  id             String             @id @default(cuid())
  fileName       String
  fileType       String             // Extension: docx, xlsx, pptx, etc.
  mimeType       String             @default("application/octet-stream")
  storagePath    String             // Relative path inside secure-storage
  fileSize       Int                @default(0)
  ownerId        String
  classification String             @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
  currentVersion Int                @default(1)
  isDeleted      Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions       DocumentVersion[]
  auditLogs      DocumentAuditLog[]
  grants         DocumentGrant[]

  @@index([ownerId])
  @@index([classification])
  @@index([createdAt])
  @@index([isDeleted])
}

/// Explicit grant for non-owner access to ONLYOFFICE-backed documents (deny-by-default).
model DocumentGrant {
  id          String   @id @default(cuid())
  documentId  String
  granteeId   String
  permission  String   @default("view") // view | edit
  createdAt   DateTime @default(now())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  grantee     User     @relation("DocumentGrantee", fields: [granteeId], references: [id], onDelete: Cascade)

  @@unique([documentId, granteeId])
  @@index([granteeId])
}

/// Version history entry — stores path to previous version on disk.
model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  version     Int
  storagePath String   // e.g. /secure-storage/versions/{docId}/{version}.docx
  fileSize    Int      @default(0)
  changeType  String   @default("edit") // "edit" | "autosave" | "force_save" | "restore"
  changedBy   String?  // userId who triggered the save
  createdAt   DateTime @default(now())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
  @@index([createdAt])
}

/// Append-only audit log for every document event.
model DocumentAuditLog {
  id         String   @id @default(cuid())
  documentId String
  userId     String?
  action     String   // "upload" | "view" | "edit" | "download" | "delete"
  ipAddress  String?
  userAgent  String?
  metadata   String?  // JSON — extra context
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

/// Real-time collaboration chat messages per document.
model DocumentChatMessage {
  id         String   @id @default(cuid())
  fileId     String
  sender     String
  level      Int      @default(2)
  message    String
  isPrivate  Boolean  @default(false)
  targetUser String?
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([fileId])
  @@index([createdAt])
}

// ============================================
// MONGODB FILE MANAGEMENT
// ============================================

/// Mongo-stored file metadata. Actual files live in MongoDB GridFS.
model MongoFile {
  id               String        @id @default(cuid())
  gridFSId         String        @unique    // GridFS file _id
  originalFileName String                   // User-facing filename
  mimeType         String                   // Server-validated MIME type
  fileExtension    String                   // e.g. "pdf", "docx"
  fileSize         Int                      // Bytes
  checksum         String                   // SHA-256 of file content
  folder           String        @default("vendor-uploads") // vendor-uploads | final-submissions | temp | audit
  projectId        String?                  // Project scoping
  vendorId         String?                  // Vendor scoping
  uploadedBy       String                   // User ID who uploaded
  classification   String        @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
  status           String        @default("active")   // active | submitted | access-revoked | archived
  scanStatus       String        @default("pending")  // pending | clean | infected | error
  scanResult       String?                  // JSON — scanner output
  isDeleted        Boolean       @default(false)
  deletedAt        DateTime?
  deletedBy        String?
  deletionReason   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  uploadLogs       MongoUploadLog[]
  accessLogs       MongoAccessLog[]
  userFile         UserFile?

  @@index([uploadedBy])
  @@index([projectId])
  @@index([vendorId])
  @@index([folder])
  @@index([classification])
  @@index([status])
  @@index([scanStatus])
  @@index([isDeleted])
  @@index([createdAt])
}

/// Append-only upload audit log. One entry per upload attempt (success or failure).
model MongoUploadLog {
  id             String   @id @default(cuid())
  mongoFileId    String
  uploadedBy     String
  ipAddress      String?
  userAgent      String?
  fileSize       Int
  checksum       String
  classification String
  status         String   @default("success") // success | failed | rejected
  errorMessage   String?
  createdAt      DateTime @default(now())

  mongoFile      MongoFile @relation(fields: [mongoFileId], references: [id], onDelete: Cascade)

  @@index([mongoFileId])
  @@index([uploadedBy])
  @@index([createdAt])
}

/// Append-only access log for every file interaction.
/// Tracks downloads, presigned URL generation, grants, and revocations.
model MongoAccessLog {
  id          String    @id @default(cuid())
  mongoFileId String
  accessedBy  String                 // User ID
  accessType  String                 // download | presign | grant | revoke | delete | view
  ipAddress   String?
  userAgent   String?
  metadata    String?                // JSON — extra context
  revokedAt   DateTime?              // For grant records: when access was revoked
  createdAt   DateTime  @default(now())

  mongoFile   MongoFile @relation(fields: [mongoFileId], references: [id], onDelete: Cascade)

  @@index([mongoFileId])
  @@index([accessedBy])
  @@index([accessType])
  @@index([createdAt])
  @@index([revokedAt])
}
