generator client {
  provider      = "prisma-client-js"
  // native = local/dev; rhel-openssl-3.0.x = Vercel Node serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuditLog {
  id         String      @id @default(cuid())
  action     String
  timestamp  DateTime    @default(now())
  linkId     String?
  /// Denormalized from SecureLink.ownerId so owner dashboards survive link cleanup
  /// and avoid nested relation filters on the timestamp-ordered hot path.
  ownerId    String?
  metadata   String?
  reason     String?
  prevHash   String?
  entryHash  String?
  SecureLink SecureLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  @@index([action])
  @@index([linkId])
  @@index([timestamp])
  @@index([linkId, action, timestamp])
  @@index([ownerId, timestamp])
  @@index([entryHash])
}

model SecureLink {
  id                 String     @id @default(cuid())
  token              String     @unique
  otpHash            String
  expiresAt          DateTime
  isUsed             Boolean    @default(false)
  createdAt          DateTime   @default(now())
  userId             String     @unique
  isRevoked          Boolean    @default(false)
  ownerToken         String     @unique
  deviceHash         String?
  failedAttempts     Int        @default(0)
  lockedAt           DateTime?
  notificationEmail  String?
  purpose            String?
  purposeDetail      String?
  otpFirstAttemptAt  DateTime?
  otpVerifiedAt      DateTime?
  allowedVendorEmail String?
  allowEditing       Boolean    @default(false)
  allowDownload      Boolean    @default(true)
  allowComment       Boolean    @default(true)
  maxViews           Int?       // Null means unlimited
  maxDownloads       Int?       // Null means unlimited
  ownerId            String?
  organizationId     String?
  AuditLog           AuditLog[]
  User               User?      @relation(fields: [ownerId], references: [id])
  Organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  UserData           UserData      @relation(fields: [userId], references: [id], onDelete: Cascade)
  UserFile           UserFile[]
  LinkAccess         LinkAccess[]
  ChatMessage        ChatMessage[]
  VendorAccess       VendorAccess[]
  FileViewEvent      FileViewEvent[]
  @@index([expiresAt])
  @@index([ownerId])
  @@index([ownerId, createdAt])
  @@index([ownerId, isRevoked, expiresAt])
  @@index([isRevoked])
  @@index([allowedVendorEmail])
  @@index([organizationId])
}
enum VendorStatus {
  active
  break
  completed
  expired
}

model VendorAccess {
  id             String     @id @default(cuid())
  secureLinkId   String
  email          String
  level          Int        @default(2) // 1 = Team leader
  otpHash        String?
  loginCount     Int        @default(0)
  maxLogins      Int        @default(3)
  failedAttempts Int        @default(0)
  isRevoked      Boolean    @default(false)
  createdAt      DateTime   @default(now())

  // Session & Resume Fields
  status             VendorStatus @default(active)
  lastSavedWork      Json?
  resumePoint        Json?
  lastCommitAt       DateTime?
  breakStartedAt     DateTime?
  currentPage        Int        @default(1)
  activeWorkDuration Int        @default(0)
  totalBreakDuration Int        @default(0)
  draftVersion       Int        @default(1)
  activeSessionId    String?
  /// Device fingerprint bound to the CURRENT active access session only.
  /// Cleared when the session ends (break / revoke / complete / expiry).
  /// Must NOT permanently bind the share link to the creator or first opener.
  activeDeviceHash   String?
  lastLoginAt        DateTime?
  lastSeenAt         DateTime?

  // Break-Based OTP Rotation
  taskDurationHours   Int        @default(8)
  allowedBreaks       Int        @default(3)     // Math.floor(taskDurationHours / 2) - 1
  breaksUsed          Int        @default(0)
  currentOtpHash      String?                    // Only this hash is accepted for authentication
  currentOtpCreatedAt DateTime?
  currentOtpExpiresAt DateTime?

  OtpHistory     OtpHistory[]
  SecureLink     SecureLink @relation(fields: [secureLinkId], references: [id], onDelete: Cascade)

  @@unique([secureLinkId, email])
  @@index([secureLinkId])
  @@index([email])
  @@index([email, status])
  @@index([activeSessionId])
}

/// Append-only OTP history for forensic audit.
/// Records are NEVER deleted — only marked INVALIDATED when a break occurs.
/// Only the newest ACTIVE OTP is accepted for authentication.
model OtpHistory {
  id              String       @id @default(cuid())
  vendorAccessId  String
  otpHash         String
  createdAt       DateTime     @default(now())
  invalidatedAt   DateTime?
  reason          String       @default("INITIAL")      // INITIAL | BREAK_STARTED | EXPIRED | REVOKED
  status          String       @default("ACTIVE")       // ACTIVE | INVALIDATED

  VendorAccess    VendorAccess @relation(fields: [vendorAccessId], references: [id], onDelete: Cascade)

  @@index([vendorAccessId])
  @@index([status])
  @@index([vendorAccessId, status])
}


model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  role           String       @default("VENDOR")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  roleSelected   Boolean      @default(false)
  organizationId String?
  Account        Account[]
  SecureLink     SecureLink[]
  Session        Session[]
  SendRecord     SendRecord[]
  Organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  memberships    OrganizationMember[]

  @@index([role])
  @@index([organizationId])
}

model UserData {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  dataHash      String
  encryptedData String
  SecureLink    SecureLink?
}

model UserFile {
  id               String        @id @default(cuid())
  fileName         String
  fileType         String
  fileSize         Int
  version          Int           @default(1)
  eTag             String        @default(cuid()) // Conflict detection
  lockedBy         String?       // ID of user currently holding the lock
  encryptedContent Bytes?
  iv               String?
  authTag          String?
  encryptedDek     String?
  mongoFileId      String?       @unique
  mongoFile        MongoFile?    @relation(fields: [mongoFileId], references: [id])
  status               String        @default("draft") // draft | editing | submitted | approved | rejected | revoked
  submittedAt          DateTime?
  submittedBy          String?
  editingLocked        Boolean       @default(false)
  vendorDownloadBlocked Boolean      @default(true)
  secureLinkId         String
  SecureLink           SecureLink    @relation(fields: [secureLinkId], references: [id], onDelete: Cascade)
  FileVersion          FileVersion[]
  Annotation           Annotation[]

  @@index([secureLinkId])
  @@index([status])
  @@index([lockedBy])
}

model FileVersion {
  id                String   @id @default(cuid())
  fileId            String
  versionNumber     Int
  encryptedContent  Bytes?   // legacy inline ciphertext; new rows use storageKey
  storageKey        String?  // gridfs:<oid> object-store pointer
  iv                String
  authTag           String
  encryptedDek      String?
  fileSize          Int
  changeType        String   // "annotation" | "page_replace" | "restore" | "collaborative_edit" | "PRIORITY_TAKEOVER"
  changeDescription String?
  createdBy         String?
  reason            String?
  previousVersionId String?
  createdAt         DateTime @default(now())
  UserFile          UserFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, versionNumber])
  @@index([fileId])
  @@index([createdAt])
  @@index([createdBy])
  @@index([reason])
  @@index([storageKey])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Preserved record of data sharing — survives data deletion.
/// Lets the owner see WHO they sent data to and WHAT topic it was about,
/// even after the actual data has been purged from the database.
model SendRecord {
  id              String   @id @default(cuid())
  ownerId         String
  topic           String                        // Mandatory: what data was shared
  vendorEmail     String?                       // Who it was sent to
  fileCount       Int      @default(0)          // How many files were attached
  status          String   @default("expired")  // expired | revoked | cleaned
  createdAt       DateTime @default(now())      // When the link was created
  expiredAt       DateTime?                     // When it expired/was revoked
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([createdAt])
  @@index([ownerId, createdAt])
  @@index([ownerId, status])
  @@index([ownerId, status, topic])
}

/// Persistent annotation overlay stored separately from the encrypted document.
model Annotation {
  id         String   @id @default(cuid())
  fileId     String
  pageNumber Int
  type       String   // "highlight" | "text" | "draw" | "comment" | "signature"
  data       String   // JSON blob (DocumentAnnotation shape)
  authorId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  UserFile   UserFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([pageNumber])
  @@index([fileId, createdAt])
}

/// Active editing session for presence tracking.
model DocumentSession {
  id          String   @id @default(cuid())
  fileId      String
  userId      String?
  token       String
  role        String   @default("VENDOR")
  level       Int      @default(2) // 1 = Team Leader, 2+ = Members
  displayName String   @default("User")
  color       String   @default("#6366f1")
  joinedAt    DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([fileId])
  @@index([token])
  @@index([token, lastSeenAt])
}

/// Append-only audit log of collaboration operations.
model CollabOperation {
  id        String   @id @default(cuid())
  fileId    String
  sessionId String
  opType    String
  payload   String   // JSON
  version   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([fileId])
  @@index([createdAt])
  @@index([fileId, createdAt])
}

/// Link access mapping for multiple vendors with hierarchy levels.
model LinkAccess {
  id           String     @id @default(cuid())
  secureLinkId String
  vendorEmail  String
  level            Int        @default(2) // 1 = Team Leader, 2+ = Member
  otpHash          String?    // Per-vendor unique OTP hash
  isUsed           Boolean    @default(false)
  otpVerifiedAt    DateTime?
  deviceHash       String?
  failedAttempts   Int        @default(0)
  lockedAt         DateTime?
  otpFirstAttemptAt DateTime?
  SecureLink       SecureLink @relation(fields: [secureLinkId], references: [id], onDelete: Cascade)

  @@unique([secureLinkId, vendorEmail])
  @@index([vendorEmail])
}

/// Real-time collaboration chat messages.
model ChatMessage {
  id            String     @id @default(cuid())
  secureLinkId  String
  senderEmail   String
  receiverEmail String?    // null = Group Chat, string = Direct Message
  content       String
  timestamp     DateTime   @default(now())
  SecureLink    SecureLink @relation(fields: [secureLinkId], references: [id], onDelete: Cascade)

  @@index([secureLinkId])
  @@index([timestamp])
  @@index([secureLinkId, timestamp])
}

// ============================================
// TENANT + ANALYTICS
// ============================================

model Organization {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  allowedDomain String?
  kmsKeyId      String?
  /// FREE | TEAM | ENTERPRISE — plan limits enforced on create-link
  plan          String               @default("FREE")
  suspendedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       OrganizationMember[]
  invites       OrganizationInvite[]
  users         User[]
  links         SecureLink[]

  @@index([allowedDomain])
  @@index([plan])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  /// OWNER
  role           String       @default("OWNER")
  /// Manager who oversees this team leader (userId of a MANAGER member)
  managerUserId  String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([managerUserId])
  @@index([organizationId, role])
}

/// Pending invite to join a company as OWNER.
model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  /// OWNER
  role           String
  managerUserId  String?
  invitedById    String
  token          String       @unique @default(cuid())
  acceptedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

model FileViewEvent {
  id          String     @id @default(cuid())
  linkId      String
  fileId      String
  viewerEmail String?
  pageNumber  Int        @default(1)
  createdAt   DateTime   @default(now())
  SecureLink  SecureLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
  @@index([fileId, createdAt])
  @@index([linkId, fileId])
}

/// Real-time collaboration chat messages per file.
model DocumentChatMessage {
  id         String   @id @default(cuid())
  fileId     String
  sender     String
  level      Int      @default(2)
  message    String
  isPrivate  Boolean  @default(false)
  targetUser String?
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([fileId])
  @@index([createdAt])
  @@index([fileId, createdAt])
}

// ============================================
// MONGODB FILE MANAGEMENT
// ============================================

/// File metadata in Postgres. Ciphertext lives in MongoDB GridFS (24-hex ObjectId).
model MongoFile {
  id               String        @id @default(cuid())
  gridFSId         String        @unique    // GridFS ObjectId
  originalFileName String                   // User-facing filename
  mimeType         String                   // Server-validated MIME type
  fileExtension    String                   // e.g. "pdf", "docx"
  fileSize         Int                      // Bytes
  checksum         String                   // SHA-256 of file content
  folder           String        @default("vendor-uploads") // vendor-uploads | final-submissions | temp | audit
  projectId        String?                  // Project scoping
  vendorId         String?                  // Vendor scoping
  uploadedBy       String                   // User ID who uploaded
  classification   String        @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
  status           String        @default("active")   // active | submitted | access-revoked | archived
  scanStatus       String        @default("pending")  // pending | clean | infected | error
  scanResult       String?                  // JSON — scanner output
  isDeleted        Boolean       @default(false)
  deletedAt        DateTime?
  deletedBy        String?
  deletionReason   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  uploadLogs       MongoUploadLog[]
  accessLogs       MongoAccessLog[]
  userFile         UserFile?

  @@index([uploadedBy])
  @@index([projectId])
  @@index([vendorId])
  @@index([folder])
  @@index([classification])
  @@index([status])
  @@index([scanStatus])
  @@index([isDeleted])
  @@index([createdAt])
}

/// Append-only upload audit log. One entry per upload attempt (success or failure).
model MongoUploadLog {
  id             String   @id @default(cuid())
  mongoFileId    String
  uploadedBy     String
  ipAddress      String?
  userAgent      String?
  fileSize       Int
  checksum       String
  classification String
  status         String   @default("success") // success | failed | rejected
  errorMessage   String?
  createdAt      DateTime @default(now())

  mongoFile      MongoFile @relation(fields: [mongoFileId], references: [id], onDelete: Cascade)

  @@index([mongoFileId])
  @@index([uploadedBy])
  @@index([createdAt])
}

/// Append-only access log for every file interaction.
/// Tracks downloads, presigned URL generation, grants, and revocations.
model MongoAccessLog {
  id          String    @id @default(cuid())
  mongoFileId String
  accessedBy  String                 // User ID
  accessType  String                 // download | presign | grant | revoke | delete | view
  ipAddress   String?
  userAgent   String?
  metadata    String?                // JSON — extra context
  revokedAt   DateTime?              // For grant records: when access was revoked
  createdAt   DateTime  @default(now())

  mongoFile   MongoFile @relation(fields: [mongoFileId], references: [id], onDelete: Cascade)

  @@index([mongoFileId])
  @@index([accessedBy])
  @@index([accessType])
  @@index([createdAt])
  @@index([revokedAt])
}

/// Durable background work (OTP email, blob GC). Drained by /api/cleanup and after().
model Job {
  id          String   @id @default(cuid())
  type        String
  payload     Json
  status      String   @default("pending") // pending | processing | done | failed
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  runAfter    DateTime @default(now())
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, runAfter])
  @@index([type, status])
}
