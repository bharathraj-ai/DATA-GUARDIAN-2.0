generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuditLog {
  id         String      @id
  action     String
  timestamp  DateTime    @default(now())
  linkId     String?
  metadata   String?
  reason     String?
  SecureLink SecureLink? @relation(fields: [linkId], references: [id])

  @@index([action])
  @@index([linkId])
  @@index([timestamp])
}

model SecureLink {
  id                 String     @id
  token              String     @unique
  otpHash            String
  expiresAt          DateTime
  isUsed             Boolean    @default(false)
  createdAt          DateTime   @default(now())
  userId             String     @unique
  isRevoked          Boolean    @default(false)
  ownerToken         String     @unique
  deviceHash         String?
  failedAttempts     Int        @default(0)
  lockedAt           DateTime?
  notificationEmail  String?
  purpose            String?
  purposeDetail      String?
  otpFirstAttemptAt  DateTime?
  otpVerifiedAt      DateTime?
  allowedVendorEmail String?
  ownerId            String?
  otpPlain           String?
  AuditLog           AuditLog[]
  User               User?      @relation(fields: [ownerId], references: [id])
  UserData           UserData   @relation(fields: [userId], references: [id], onDelete: Cascade)
  UserFile           UserFile[]

  @@index([allowedVendorEmail])
  @@index([expiresAt])
  @@index([ownerId])
  @@index([ownerToken])
  @@index([token])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String       @id
  email         String       @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          String       @default("VENDOR")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  roleSelected  Boolean      @default(false)
  Account       Account[]
  SecureLink    SecureLink[]
  Session       Session[]
}

model UserData {
  id            String      @id
  createdAt     DateTime    @default(now())
  dataHash      String
  encryptedData String
  SecureLink    SecureLink?
}

model UserFile {
  id               String     @id
  fileName         String
  fileType         String
  fileSize         Int
  encryptedContent Bytes
  iv               String
  authTag          String
  secureLinkId     String
  createdAt        DateTime   @default(now())
  SecureLink       SecureLink @relation(fields: [secureLinkId], references: [id], onDelete: Cascade)

  @@index([secureLinkId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
