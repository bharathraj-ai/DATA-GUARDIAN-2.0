# Secure Protocol — required environment variables (never commit real values)

# Database
DATABASE_URL=
DIRECT_URL=

# Auth
# Local: http://localhost:3000
# Vercel: https://YOUR-PROJECT.vercel.app  (must match the live site — no trailing slash)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Google Workspace restriction (hd=)
# GOOGLE_HOSTED_DOMAIN=acme.com

# Optional OIDC SSO (Entra / Okta / Keycloak). Sign-in shows a second button when NEXT_PUBLIC_SSO_NAME is set.
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Company SSO
# NEXT_PUBLIC_SSO_NAME=Company SSO

# Encryption — use SEPARATE 64-hex keys. Production refuses to boot if these
# are missing, identical, or if OTP/session HMAC fall back to ENCRYPTION_KEY.
ENCRYPTION_KEY=          # AES-256-GCM for UserData / buffers (64 hex chars)
KEK_KEY=                 # Wraps per-file DEKs (64 hex chars) — MUST differ from ENCRYPTION_KEY
OTP_HMAC_SECRET=         # OTP hashing (min 32 chars; required in production)
SESSION_HMAC_SECRET=     # Share-session cookie MAC (min 32 chars; required in production)

# Optional HTTP KMS for customer-managed DEK wrap (unset = local KEK_KEY)
# KMS_WRAP_URL=
# KMS_UNWRAP_URL=
# KMS_TOKEN=

# Redis — REQUIRED in production (kill-switch, rate limits, edit locks)
# Local dev may omit; rate limits then fall back per-process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error tracking (optional — no-ops if unset)
SENTRY_DSN=

# Prisma pool (optional — Neon pooler defaults are applied automatically)
# PRISMA_CONNECTION_LIMIT=10
# PRISMA_POOL_TIMEOUT=15

# Mongo DB name (optional)
# MONGODB_DB_NAME=data-guardian

# Cron cleanup
CRON_SECRET=             # min 32 characters

# Audit log HMAC chain (required in production; must differ from SESSION_HMAC_SECRET)
AUDIT_HMAC_SECRET=

# Ciphertext object store = MongoDB GridFS (not S3). Set MONGODB_URI below.
# Malware scan: local signatures always run; optional Lambda (≤4MB) and/or HTTP webhook.
# Production uploads require a clean scan result (fail-closed).
AWS_LAMBDA_SCAN_FUNCTION=data-guardian-malware-scan
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MALWARE_SCAN_WEBHOOK_URL=
MALWARE_SCAN_TOKEN=

# Optional: comma-separated emails elevated to platform ADMIN on sign-in
# ADMIN_EMAILS=ops@yourdomain.com

# App
# Local: http://localhost:3000
# Production (this project): https://data-guardian-2-0.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Mongo GridFS — ciphertext object store (required for create-link uploads)
MONGODB_URI=

# Email (required for OTP delivery on Vercel)
# Gmail: use an App Password — https://myaccount.google.com/apppasswords
EMAIL_USER=               # or SMTP_USER
EMAIL_PASS=               # or SMTP_PASS (Gmail app password, not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_FROM=                 # optional display/from address
EMAIL_FROM_NAME=Secure Protocol Security
