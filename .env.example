# Data Guardian — required environment variables (never commit real values)

# Database
DATABASE_URL=
DIRECT_URL=

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption — use SEPARATE 64-hex keys in production
ENCRYPTION_KEY=          # AES-256-GCM for UserData / buffers (64 hex chars)
KEK_KEY=                 # Wraps per-file DEKs (64 hex chars)
OTP_HMAC_SECRET=         # OTP hashing (falls back to ENCRYPTION_KEY if unset)
SESSION_HMAC_SECRET=     # Share-session cookie MAC (falls back to NEXTAUTH_SECRET)

# Redis (optional but recommended for kill-switch + rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron cleanup
CRON_SECRET=             # min 32 characters

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
SECURE_STORAGE_PATH=./secure-storage

# Mongo (file storage)
MONGODB_URI=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
