# Data Guardian — required environment variables (never commit real values)

# Database
DATABASE_URL=
DIRECT_URL=

# Auth
# Local: http://localhost:3000
# Vercel: https://YOUR-PROJECT.vercel.app  (must match the live site — no trailing slash)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption — use SEPARATE 64-hex keys in production
# If local + Vercel share the same DATABASE_URL, these MUST be identical on both.
ENCRYPTION_KEY=          # AES-256-GCM for UserData / buffers (64 hex chars)
KEK_KEY=                 # Wraps per-file DEKs (64 hex chars)
OTP_HMAC_SECRET=         # OTP hashing (falls back to ENCRYPTION_KEY if unset)
SESSION_HMAC_SECRET=     # Share-session cookie MAC (falls back to NEXTAUTH_SECRET)

# Redis (strongly recommended in production / multi-instance)
# Without Redis: kill-switch, rate limits, and edit locks fall back per-process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Priority editing — 0 means no countdown / no reservation clock
EDIT_LOCK_GRACE_PERIOD_SECONDS=0
EDIT_LOCK_RESERVATION_SECONDS=0
EDIT_LOCK_SAME_PRIORITY_POLICY=keep_current
EDIT_LOCK_TTL_SECONDS=120
EDIT_LOCK_MAX_RESERVATION_SECONDS=0
EDIT_LOCK_STALE_HEARTBEAT_MS=90000

# Prisma pool (optional — Neon pooler defaults are applied automatically)
# PRISMA_CONNECTION_LIMIT=10
# PRISMA_POOL_TIMEOUT=15

# Mongo DB name (optional)
# MONGODB_DB_NAME=data-guardian

# ONLYOFFICE iframe origin used in editor CSP (optional / legacy)
# ONLYOFFICE_SERVER_URL=http://localhost:8080

# Cron cleanup
CRON_SECRET=             # min 32 characters

# App
# Local: http://localhost:3000
# Production (this project): https://data-guardian-2-0.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
SECURE_STORAGE_PATH=./secure-storage

# Mongo (file storage)
MONGODB_URI=

# Email (required for OTP delivery on Vercel)
# Gmail: use an App Password — https://myaccount.google.com/apppasswords
EMAIL_USER=               # or SMTP_USER
EMAIL_PASS=               # or SMTP_PASS (Gmail app password, not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_FROM=                 # optional display/from address
EMAIL_FROM_NAME=Data Guardian Security
